# Copy this file to .env and fill in a real key to use the real Claude API.
# Without a key, the broker runs in MOCK MODE with canned responses so the
# pipeline still works end-to-end for development/demo purposes.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Per-role secrets. Each container's docker-compose entry is only handed the
# token(s) it needs — red-team never sees BLUE_TEAM_TOKEN or AUDIT_TOKEN, etc.
# This is what actually stops blue-team from reading the audit log (which
# contains the original attack prompts) even though it's network-reachable.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUDIT_HMAC_KEY=
RED_TEAM_TOKEN=
BLUE_TEAM_TOKEN=
AUDIT_TOKEN=
