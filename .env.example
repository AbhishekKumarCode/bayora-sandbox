# Copy this file to .env and fill in a real key to use the real Claude API.
# Without a key, the broker runs in MOCK MODE with canned responses so the
# pipeline still works end-to-end for development/demo purposes.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OR use any OpenAI-compatible provider instead of Anthropic (leave ANTHROPIC_API_KEY empty):
#   Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=llama-3.3-70b-versatile
#   Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
#   Ollama (local):     LLM_BASE_URL=http://host.docker.internal:11434/v1                     LLM_MODEL=llama3.2:3b   (no key needed)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: override the system prompt the model under test runs with. The default
# contains a fake secret so prompt-leak attacks have something to leak.
SYSTEM_PROMPT=

# Per-role secrets. Each container's docker-compose entry is only handed the
# token(s) it needs — red-team never sees BLUE_TEAM_TOKEN or AUDIT_TOKEN, etc.
# This is what actually stops blue-team from reading the audit log (which
# contains the original attack prompts) even though it's network-reachable.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUDIT_HMAC_KEY=
RED_TEAM_TOKEN=
BLUE_TEAM_TOKEN=
AUDIT_TOKEN=
